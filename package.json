{
  "name": "molo-xhosa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "phone": "node scripts/phone.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:voice": "node --test tests/voice.corpus.mjs",
    "audit:audio": "node scripts/audit-audio.mjs",
    "audio:plan": "uv run --locked python scripts/generate-uniform-audio.py --plan",
    "audio:generate": "uv run --locked python scripts/generate-uniform-audio.py --generate",
    "audio:review": "node scripts/review-audio.mjs",
    "test:audio-generation": "uv run --locked python tests/audio-generation.test.py",
    "test:all": "npm test && npm run build && npm run test:voice && npm run test:e2e",
    "voice:setup": "node scripts/setup-voice.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "1.59.0",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
